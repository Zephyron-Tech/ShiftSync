# --- WhatsApp bot (/api/whatsapp). All values come from the Meta app dashboard. ---
WHATSAPP_TOKEN=            # permanent System User token
WHATSAPP_PHONE_ID=         # Phone number ID of the bot number
WHATSAPP_APP_SECRET=       # App settings > Basic > App Secret (verifies webhook signatures)
WHATSAPP_VERIFY_TOKEN=     # any random string; paste the same one in the webhook settings
# Only these senders are served: WhatsApp number (digits only) -> name exactly as in the PDF
PERSON_MAP={"420777123456":"Příjmení Jméno"}
# Public address of the deployed app (used in the reply link)
PUBLIC_BASE_URL=https://your-app.vercel.app
# Key for the per-person calendar/editor tokens (long random string, e.g. `openssl rand -base64 48`).
# Keep it separate from WHATSAPP_APP_SECRET so the Meta secret can be rotated without breaking subscriptions.
# Moving an existing install: set it to the current WHATSAPP_APP_SECRET value first, then rotate the Meta secret.
CALENDAR_SECRET=

# --- Google Calendar import button (optional). Without it the Google option falls back to a calendar-by-URL link. ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Name preselected in the web app before the person picks one (exactly as in the PDF). Optional.
NEXT_PUBLIC_DEFAULT_PERSON=
